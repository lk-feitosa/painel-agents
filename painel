#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import os
import sys
from pathlib import Path

# Redireciona para o painel.py na mesma pasta
raiz = Path(__file__).resolve().parent
script = raiz / "painel.py"

if __name__ == "__main__":
    if not script.exists():
        print(f"Erro: {script} não encontrado.")
        sys.exit(1)
    # Executa o painel
    import subprocess
    sys.exit(subprocess.call([sys.executable, str(script)] + sys.argv[1:]))
